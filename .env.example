# BAGATTA SYNC — Variables de entorno


# ── Alegra ──────────────────────────────────────────────────
ALEGRA_EMAIL=tucorreo@gmail.com
ALEGRA_TOKEN=tu_token_de_api_de_alegra

# ── Shopify (Dev Dashboard 2026) ─────────────────────────────
# El dominio interno de tu tienda (sin https://)
SHOPIFY_STORE=tu-tienda.myshopify.com
# Client ID y Client Secret del Dev Dashboard (dev.shopify.com)
SHOPIFY_CLIENT_ID=tu_client_id
SHOPIFY_CLIENT_SECRET=tu_client_secret
# Los tokens de 24h se obtienen y renuevan AUTOMATICAMENTE — no los pongas aqui

# (Opcional) Shopify Location/sucursal donde ajustar inventario.
# Si no lo defines, se usará la primera location que devuelva Shopify.
# Puedes verlas en: GET /debug/shopify-locations
# SHOPIFY_LOCATION_ID=gid://shopify/Location/123456789
# SHOPIFY_LOCATION_NAME=Sucursal de la tienda

# (Opcional) Si tienes varias sucursales y quieres forzar el mismo stock en todas:
# SHOPIFY_SYNC_ALL_LOCATIONS=true

# ── Servidor ─────────────────────────────────────────────────
PORT=3000
# Intervalo de sync Alegra → Shopify en milisegundos
# 300000=5min | 60000=1min | 600000=10min
SYNC_INTERVAL_MS=300000

# Auto-sync bidireccional (Alegra ↔ Shopify) por último cambio detectado
# true recomendado para operación automática sin intervención manual
AUTO_SYNC_ENABLED=true
# Frecuencia de revisión bidireccional (ms). Recomendado 10000-30000.
AUTO_SYNC_INTERVAL_MS=10000

# (Opcional) Delay entre páginas al listar ítems de Alegra (si hay rate-limit)
# ALEGRA_PAGE_DELAY_MS=100

